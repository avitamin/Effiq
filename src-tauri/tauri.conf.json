{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Effiq Review Runner",
  "version": "0.1.0",
  "identifier": "dev.effiq.review-runner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Effiq Review Runner",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["deb", "rpm"]
  }
}
